# Konfigurasi stack test drive untuk server. Salin lalu isi:
#
#   cp .env.demo.example .env.demo
#   docker compose -f docker-compose.demo.yml --env-file .env.demo up -d --build
#
# File .env.demo tidak ikut ter-commit (lihat .gitignore). Tanpa file ini pun compose tetap
# jalan memakai default-nya, yaitu persis konfigurasi lokal di README.

# --- Cara situs memanggil API -------------------------------------------------------------
# same-origin.json  : untuk di balik reverse proxy. Situs memanggil host yang melayani dia
#                     sendiri, jadi proxy harus meneruskan /api/ ke container api.
# Production.json   : dua port terpisah di localhost (mode lokal, default).
DEMO_WEB_CONFIG=./docker/demo/web-appsettings.same-origin.json

# Origin publik situs demo. Hanya dipakai untuk CORS, yang jadi tidak relevan kalau
# DEMO_WEB_CONFIG di atas same-origin — tapi isi dengan benar supaya tetap benar kalau suatu
# saat situs dan API dipisah ke dua nama host.
DEMO_PUBLIC_ORIGIN=https://demo.contohdomain.com

# --- Port lokal yang didengarkan reverse proxy --------------------------------------------
# Semuanya di-bind ke 127.0.0.1, tidak pernah ke publik. Ubah kalau bentrok dengan aplikasi
# lain yang sudah jalan di VPS.
DEMO_WEB_PORT=8082
DEMO_API_PORT=5343
DEMO_DB_PORT=5433

# --- Rahasia ------------------------------------------------------------------------------
# Wajib diganti di server: nilai default-nya tertulis di repo publik.
#   openssl rand -base64 48
DEMO_JWT_SECRET=ganti-dengan-hasil-openssl-rand-base64-48
DEMO_DB_PASSWORD=ganti-dengan-password-acak

# Login pemilik di stack demo. Bukan untuk dipakai siapa pun — akun demo-lah pintu masuknya —
# tapi login ini tetap hidup dan mendarat di schema `public` yang tidak ter-sandbox, jadi beri
# password acak dan jangan dibagikan.
DEMO_OWNER_USERNAME=owner
DEMO_OWNER_PASSWORD=ganti-dengan-password-acak

# --- Akun test drive ----------------------------------------------------------------------
# Sengaja ditampilkan di halaman login dan boleh diketahui siapa saja: tiap login dapat
# schema kosongnya sendiri dan tidak bisa menyentuh data pemilik.
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
DEMO_SESSION_MINUTES=60
DEMO_IDLE_MINUTES=20
# Tiap sesi = satu schema penuh + reindex embedding. Naikkan hanya kalau RAM VPS mengizinkan.
DEMO_MAX_SESSIONS=5

# --- Swagger ------------------------------------------------------------------------------
# Development = Swagger terbuka di /swagger. Production = mati. Error handler tidak pernah
# membocorkan stack trace di kedua mode.
DEMO_ASPNETCORE_ENVIRONMENT=Development
