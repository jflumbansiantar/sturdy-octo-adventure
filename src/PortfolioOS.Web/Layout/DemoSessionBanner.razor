@implements IDisposable

<MudAlert Severity="@(_remaining <= WarningThreshold ? Severity.Error : Severity.Warning)"
          Dense="true" Class="mb-4">
    <div class="d-flex align-center flex-wrap" style="gap: 4px 12px">
        <span>
            <b>Mode Test Drive.</b>
            Semua data yang kamu buat di sesi ini <b>dihapus permanen</b> saat logout,
            atau saat waktu sesi habis.
        </span>
        <span style="font-variant-numeric: tabular-nums; white-space: nowrap">
            <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" Class="mr-1" />
            Sisa @Formatted
        </span>
    </div>
</MudAlert>

@code {
    /// <summary>When the session's token - and its sandbox - expire.</summary>
    [Parameter, EditorRequired] public DateTimeOffset ExpiresAt { get; set; }

    /// <summary>Raised once, the moment the countdown reaches zero.</summary>
    [Parameter] public EventCallback OnExpired { get; set; }

    private static readonly TimeSpan WarningThreshold = TimeSpan.FromMinutes(5);

    private TimeSpan _remaining;
    private CancellationTokenSource? _cts;
    private bool _expiryReported;

    /// <summary>
    /// The countdown lives here, in its own component, rather than in the layout.
    /// </summary>
    /// <remarks>
    /// A per-second <c>StateHasChanged</c> on <c>MainLayout</c> would re-render <c>@@Body</c> -
    /// the whole page the user is working on - once a second, all to move two digits.
    /// </remarks>
    protected override void OnInitialized()
    {
        _remaining = Remaining();
        _cts = new CancellationTokenSource();
        _ = TickAsync(_cts.Token);
    }

    protected override void OnParametersSet() => _remaining = Remaining();

    private async Task TickAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                _remaining = Remaining();
                await InvokeAsync(StateHasChanged);

                if (_remaining > TimeSpan.Zero || _expiryReported) continue;

                _expiryReported = true;
                await OnExpired.InvokeAsync();
                return;
            }
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-tick; nothing to clean up beyond the timer's own dispose.
        }
    }

    private TimeSpan Remaining()
    {
        var left = ExpiresAt - DateTimeOffset.UtcNow;
        return left > TimeSpan.Zero ? left : TimeSpan.Zero;
    }

    private string Formatted => _remaining.TotalHours >= 1
        ? _remaining.ToString(@"h\:mm\:ss")
        : _remaining.ToString(@"mm\:ss");

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
