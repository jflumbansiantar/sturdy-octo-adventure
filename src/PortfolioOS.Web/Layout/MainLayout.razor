@inherits LayoutComponentBase
@inject AuthService AuthService
@inject NavigationManager Nav
@inject AppState AppState
@inject PortfolioApiClient Api

@if (_checked && _authenticated)
{
    <MudLayout>
        <MudAppBar Elevation="1" Color="Color.Dark">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           OnClick="@(() => _drawerOpen = !_drawerOpen)" />
            <MudText Typo="Typo.h6" Class="ml-2">PortfolioOS</MudText>
            <MudSpacer />
            <MudButton Color="Color.Inherit" OnClick="ToggleCurrency"
                       Title="@($"1 USD = Rp {AppState.UsdIdrRate:N0}{(AppState.IsRateLive ? "" : " (kurs tersimpan)")}")">
                @AppState.CurrencyLabel
            </MudButton>
            <MudIconButton Icon="@(AppState.PrivacyMode ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                           Color="Color.Inherit" Title="Toggle Privacy" OnClick="AppState.TogglePrivacy" />
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="LogoutAsync" />
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always">
            <NavMenu />
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
                @Body
            </MudContainer>
        </MudMainContent>

        @* Inside the authenticated branch on purpose: it asks questions about the user's own
           data, so it has no business floating over the login form. *@
        <AssistantFab />
    </MudLayout>
}
else if (_checked && Nav.Uri.Contains("/login"))
{
    @Body
}

@code {
    private bool _drawerOpen = true;
    private bool _checked;
    private bool _authenticated;

    protected override async Task OnInitializedAsync()
    {
        _authenticated = await AuthService.IsAuthenticatedAsync();
        _checked = true;
        if (!_authenticated && !Nav.Uri.Contains("/login"))
        {
            // Drop the stale token on the way out, so the next visit does not repeat the
            // check against a value already known to be dead.
            await AuthService.ClearTokenAsync();
            Nav.NavigateTo("/login");
            return;
        }

        // Anonymous visitors stop here. The FX endpoint requires a token, and a 401 sends
        // UnauthorizedRedirectHandler into a forced reload of /login - which runs this method
        // again, reloading forever and never letting the login form appear.
        if (!_authenticated) return;

        // Fetched once per session: the toggle needs a rate before it can show dollars, and
        // every page reads it from AppState rather than calling the API itself.
        var fx = await Api.GetExchangeRateAsync();
        if (fx is not null)
            AppState.SetRate(fx.Rate, fx.AsOf, fx.IsLive);
    }

    private void ToggleCurrency() => AppState.ToggleCurrency();

    private async Task LogoutAsync()
    {
        await AuthService.ClearTokenAsync();

        // Dropping the flag is what actually signs them out on screen. Whether to draw the app
        // bar and drawer is decided in OnInitializedAsync, which a client-side navigation does
        // not re-run - so leaving it set keeps the whole chrome wrapped around the login form,
        // nav links still clickable, as though the session were alive.
        _authenticated = false;
        Nav.NavigateTo("/login");
    }
}
