	<string>Akses galeri dipakai untuk memilih foto struk atau screenshot transaksi. Gambar diproses di perangkat ini dan tidak dikirim ke mana pun.</string>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
