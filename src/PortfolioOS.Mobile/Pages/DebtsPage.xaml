<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PortfolioOS.Mobile.ViewModels"
             x:Class="PortfolioOS.Mobile.Pages.DebtsPage"
             x:DataType="vm:DebtsViewModel"
             Title="Add Debt"
             BackgroundColor="#1A1A2E">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="New Debt" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,8,0,4" />

            <Entry Placeholder="Name (e.g. BCA Credit Card)" Text="{Binding FormName}"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Picker Title="Type" SelectedItem="{Binding FormType}"
                    ItemsSource="{Binding Types}"
                    TextColor="White" BackgroundColor="#0F3460" />

            <Entry Placeholder="Balance" Text="{Binding FormBalance}"
                   Keyboard="Numeric"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Entry Placeholder="Interest Rate (%)" Text="{Binding FormInterestRate}"
                   Keyboard="Numeric"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Entry Placeholder="Minimum Payment" Text="{Binding FormMinimumPayment}"
                   Keyboard="Numeric"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Entry Placeholder="Due Day (1–31)" Text="{Binding FormDueDay}"
                   Keyboard="Numeric"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Picker Title="Currency" SelectedItem="{Binding FormCurrency}"
                    ItemsSource="{Binding Currencies}"
                    TextColor="White" BackgroundColor="#0F3460" />

            <Entry Placeholder="Debt App / Bank" Text="{Binding FormDebtApp}"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Entry Placeholder="Notes" Text="{Binding FormNotes}"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Label Text="{Binding ErrorMessage}" TextColor="#FF6B6B" FontSize="12"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Label Text="{Binding SuccessMessage}" TextColor="#4CAF50" FontSize="12"
                   IsVisible="{Binding SuccessMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Text="Save Debt" Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="#E94560" TextColor="White" CornerRadius="8"
                    HeightRequest="48" Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
