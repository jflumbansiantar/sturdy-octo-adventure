<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PortfolioOS.Mobile.ViewModels"
             xmlns:models="clr-namespace:PortfolioOS.Mobile.Models"
             x:Class="PortfolioOS.Mobile.Pages.DebtsPage"
             x:DataType="vm:DebtsViewModel"
             Title="Add Debt"
             BackgroundColor="#1A1A2E">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="New Debt" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,8,0,4" />

            <Entry Placeholder="Name (e.g. BCA Credit Card)" Text="{Binding FormName}"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Picker Title="Type" SelectedItem="{Binding FormType}"
                    ItemsSource="{Binding Types}"
                    TextColor="White" BackgroundColor="#0F3460" />

            <Entry Placeholder="Balance" Text="{Binding FormBalance}"
                   Keyboard="Numeric"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Entry Placeholder="Interest Rate (%)" Text="{Binding FormInterestRate}"
                   Keyboard="Numeric"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Entry Placeholder="Minimum Payment" Text="{Binding FormMinimumPayment}"
                   Keyboard="Numeric"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Entry Placeholder="Due Day (1–31)" Text="{Binding FormDueDay}"
                   Keyboard="Numeric"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Picker Title="Currency" SelectedItem="{Binding FormCurrency}"
                    ItemsSource="{Binding Currencies}"
                    TextColor="White" BackgroundColor="#0F3460" />

            <Entry Placeholder="Debt App / Bank" Text="{Binding FormDebtApp}"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Entry Placeholder="Notes" Text="{Binding FormNotes}"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Label Text="{Binding ErrorMessage}" TextColor="#FF6B6B" FontSize="12"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Label Text="{Binding SuccessMessage}" TextColor="#4CAF50" FontSize="12"
                   IsVisible="{Binding SuccessMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Text="Save Debt" Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="#E94560" TextColor="White" CornerRadius="8"
                    HeightRequest="48" Margin="0,8,0,0" />


            <!-- Daftar utang -->
            <BoxView HeightRequest="1" Color="#2A2A45" Margin="0,16,0,4" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Your Debts" TextColor="White" FontSize="16" FontAttributes="Bold" />
                <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                   Color="#E94560" HeightRequest="18" WidthRequest="18" />
            </Grid>

            <Label Text="No debts yet." TextColor="#666" FontSize="13" Margin="0,4,0,0"
                   IsVisible="{Binding Debts.Count, Converter={StaticResource ZeroToTrueConverter}}" />

            <CollectionView ItemsSource="{Binding Debts}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DebtModel">
                        <Frame BackgroundColor="#16213E" BorderColor="Transparent" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding Name}" TextColor="White" FontAttributes="Bold" FontSize="15" />
                                    <Label Text="{Binding Type}" TextColor="#888" FontSize="12" />
                                    <Label Text="{Binding InterestRate, StringFormat='{0:F2}% APR'}" TextColor="#666" FontSize="11" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                    <Label TextColor="White" FontSize="14" HorizontalTextAlignment="End">
                                        <Label.Text>
                                            <MultiBinding Converter="{StaticResource MoneyConverter}">
                                                <Binding Path="Balance" />
                                                <Binding Path="Currency" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label Text="{Binding Status}"
                                           TextColor="{Binding Status, Converter={StaticResource DebtStatusColorConverter}}"
                                           FontSize="11" HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
