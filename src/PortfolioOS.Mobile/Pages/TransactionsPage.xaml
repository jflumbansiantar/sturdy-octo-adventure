<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PortfolioOS.Mobile.ViewModels"
             xmlns:models="clr-namespace:PortfolioOS.Mobile.Models"
             x:Class="PortfolioOS.Mobile.Pages.TransactionsPage"
             x:DataType="vm:TransactionsViewModel"
             Title="Transactions"
             BackgroundColor="#1A1A2E">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" Command="{Binding ToggleAddFormCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <!-- Add Form (collapsible) -->
        <Frame Grid.Row="0" BackgroundColor="#16213E" BorderColor="Transparent"
               CornerRadius="0" Padding="16"
               IsVisible="{Binding ShowAddForm}">
            <VerticalStackLayout Spacing="10">
                <Label Text="New Transaction" TextColor="White" FontSize="15" FontAttributes="Bold" />

                <Entry Placeholder="Name / Description" Text="{Binding FormName}"
                       PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

                <Picker Title="Category" SelectedItem="{Binding FormCategory}"
                        ItemsSource="{Binding Categories}"
                        TextColor="White" BackgroundColor="#0F3460" />

                <Entry Placeholder="Type (e.g. Credit, Debit)" Text="{Binding FormType}"
                       PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

                <Entry Placeholder="Amount (USD)" Text="{Binding FormTotal}"
                       Keyboard="Numeric"
                       PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

                <Label Text="{Binding ErrorMessage}" TextColor="#FF6B6B" FontSize="12"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

                <HorizontalStackLayout Spacing="12">
                    <Button Text="Cancel" Command="{Binding ToggleAddFormCommand}"
                            BackgroundColor="#333" TextColor="White" CornerRadius="8"
                            HorizontalOptions="FillAndExpand" HeightRequest="44" />
                    <Button Text="Save" Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                            BackgroundColor="#E94560" TextColor="White" CornerRadius="8"
                            HorizontalOptions="FillAndExpand" HeightRequest="44" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>

        <!-- List -->
        <RefreshView Grid.Row="1" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
            <CollectionView ItemsSource="{Binding Transactions}" Margin="16,8">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TransactionModel">
                        <Frame BackgroundColor="#16213E" BorderColor="Transparent" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- Category badge -->
                                <Frame Grid.Column="0" BackgroundColor="#0F3460" BorderColor="Transparent"
                                       CornerRadius="6" Padding="6,4" WidthRequest="60" Margin="0,0,12,0">
                                    <Label Text="{Binding Category}" TextColor="#AAA" FontSize="10" HorizontalTextAlignment="Center" />
                                </Frame>

                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding Name}" TextColor="White" FontSize="14" />
                                    <Label Text="{Binding Date, StringFormat='{0:dd MMM yyyy}'}" TextColor="#888" FontSize="11" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="{Binding Total, StringFormat='${0:N2}'}"
                                       TextColor="White" FontSize="14" FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="No transactions yet." TextColor="#888" HorizontalTextAlignment="Center" Margin="0,32,0,0" />
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
