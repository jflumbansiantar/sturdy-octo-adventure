<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PortfolioOS.Mobile.ViewModels"
             xmlns:models="clr-namespace:PortfolioOS.Mobile.Models"
             x:Class="PortfolioOS.Mobile.Pages.TransactionsPage"
             x:DataType="vm:TransactionsViewModel"
             Title="Add Transaction"
             BackgroundColor="#1A1A2E">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="New Transaction" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,8,0,4" />

            <Entry Placeholder="Name / Description" Text="{Binding FormName}"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Picker Title="Category" SelectedItem="{Binding FormCategory}"
                    ItemsSource="{Binding Categories}"
                    TextColor="White" BackgroundColor="#0F3460" />

            <Entry Placeholder="Type (e.g. Credit, Debit)" Text="{Binding FormType}"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Entry Placeholder="Amount (USD)" Text="{Binding FormTotal}"
                   Keyboard="Numeric"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Label Text="{Binding ErrorMessage}" TextColor="#FF6B6B" FontSize="12"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Label Text="{Binding SuccessMessage}" TextColor="#4CAF50" FontSize="12"
                   IsVisible="{Binding SuccessMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Text="Save Transaction" Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="#E94560" TextColor="White" CornerRadius="8"
                    HeightRequest="48" Margin="0,8,0,0" />


            <!-- Daftar transaksi -->
            <BoxView HeightRequest="1" Color="#2A2A45" Margin="0,16,0,4" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Recent Transactions" TextColor="White" FontSize="16" FontAttributes="Bold" />
                <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                   Color="#E94560" HeightRequest="18" WidthRequest="18" />
            </Grid>

            <Label Text="No transactions yet." TextColor="#666" FontSize="13" Margin="0,4,0,0"
                   IsVisible="{Binding Transactions.Count, Converter={StaticResource ZeroToTrueConverter}}" />

            <CollectionView ItemsSource="{Binding Transactions}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TransactionModel">
                        <Frame BackgroundColor="#16213E" BorderColor="Transparent" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding Name}" TextColor="White" FontAttributes="Bold" FontSize="15" />
                                    <Label Text="{Binding Category}" TextColor="#888" FontSize="12" />
                                    <Label Text="{Binding Date, StringFormat='{0:yyyy-MM-dd}'}" TextColor="#666" FontSize="11" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                                    <Label TextColor="White" FontSize="14" HorizontalTextAlignment="End">
                                        <Label.Text>
                                            <MultiBinding Converter="{StaticResource MoneyConverter}">
                                                <Binding Path="Total" />
                                                <Binding Path="Market" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                    <Label Text="{Binding Type}" TextColor="#888" FontSize="11" HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
