<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PortfolioOS.Mobile.ViewModels"
             x:Class="PortfolioOS.Mobile.Pages.HoldingsPage"
             x:DataType="vm:HoldingsViewModel"
             Title="Add Holding"
             BackgroundColor="#1A1A2E">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="New Holding" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,8,0,4" />

            <Entry Placeholder="Ticker (e.g. AAPL)" Text="{Binding FormTicker}"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Entry Placeholder="Name (e.g. Apple Inc.)" Text="{Binding FormName}"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Picker Title="Type" SelectedItem="{Binding FormType}"
                    ItemsSource="{Binding Types}"
                    TextColor="White" BackgroundColor="#0F3460" />

            <Entry Placeholder="Sub-type (e.g. Technology)" Text="{Binding FormSubType}"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Picker Title="Market" SelectedItem="{Binding FormMarket}"
                    ItemsSource="{Binding Markets}"
                    TextColor="White" BackgroundColor="#0F3460" />

            <Entry Placeholder="Shares" Text="{Binding FormShares}"
                   Keyboard="Numeric"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Entry Placeholder="Avg Cost (per share)" Text="{Binding FormAvgCost}"
                   Keyboard="Numeric"
                   PlaceholderColor="#555" TextColor="White" BackgroundColor="#0F3460" HeightRequest="44" />

            <Label Text="{Binding ErrorMessage}" TextColor="#FF6B6B" FontSize="12"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Label Text="{Binding SuccessMessage}" TextColor="#4CAF50" FontSize="12"
                   IsVisible="{Binding SuccessMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <Button Text="Save Holding" Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="#E94560" TextColor="White" CornerRadius="8"
                    HeightRequest="48" Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
