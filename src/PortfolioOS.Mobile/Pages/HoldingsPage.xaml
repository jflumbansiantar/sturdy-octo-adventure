<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PortfolioOS.Mobile.ViewModels"
             xmlns:models="clr-namespace:PortfolioOS.Mobile.Models"
             x:Class="PortfolioOS.Mobile.Pages.HoldingsPage"
             x:DataType="vm:HoldingsViewModel"
             Title="Holdings"
             BackgroundColor="#1A1A2E">

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
        <CollectionView ItemsSource="{Binding Holdings}" Margin="16">
            <CollectionView.Header>
                <Label Text="{Binding ErrorMessage}" TextColor="#FF6B6B" Margin="0,0,0,8"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:HoldingModel">
                    <Frame BackgroundColor="#16213E" BorderColor="Transparent" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">

                            <!-- Ticker + Name -->
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Ticker}" TextColor="White"
                                   FontSize="17" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding Name}" TextColor="#888" FontSize="12" />

                            <!-- Price + Day Change -->
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding CurrentPrice, StringFormat='${0:F2}'}"
                                   TextColor="White" FontSize="16" FontAttributes="Bold"
                                   HorizontalTextAlignment="End" />
                            <Label Grid.Row="1" Grid.Column="1"
                                   TextColor="{Binding DayChangePct, Converter={StaticResource GainColorConverter}}"
                                   FontSize="12" HorizontalTextAlignment="End">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0:+0.00;-0.00;0.00}%">
                                        <Binding Path="DayChangePct" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>

                            <!-- Shares · Market Value · Gain -->
                            <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="16" Margin="0,8,0,0">
                                <VerticalStackLayout>
                                    <Label Text="Shares" TextColor="#555" FontSize="10" />
                                    <Label Text="{Binding Shares, StringFormat='{0:F4}'}" TextColor="#CCC" FontSize="12" />
                                </VerticalStackLayout>
                                <VerticalStackLayout>
                                    <Label Text="Market Value" TextColor="#555" FontSize="10" />
                                    <Label Text="{Binding MarketValue, StringFormat='${0:N2}'}" TextColor="#CCC" FontSize="12" />
                                </VerticalStackLayout>
                                <VerticalStackLayout>
                                    <Label Text="Gain/Loss" TextColor="#555" FontSize="10" />
                                    <Label Text="{Binding GainLoss, StringFormat='${0:N2}'}"
                                           TextColor="{Binding GainLoss, Converter={StaticResource GainColorConverter}}"
                                           FontSize="12" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="No holdings yet." TextColor="#888" HorizontalTextAlignment="Center" Margin="0,32,0,0" />
            </CollectionView.EmptyView>
        </CollectionView>
    </RefreshView>

</ContentPage>
