@page
@model PortfolioOS.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Password baru";
}

<h1>Password baru</h1>
<p class="sub">Password akan diperbarui untuk akun <strong>@Model.Input.Email</strong>.</p>

<div asp-validation-summary="ModelOnly" class="alert"></div>

<form method="post">
    <input type="hidden" asp-for="Input.Email"/>
    <input type="hidden" asp-for="Input.Token"/>

    <label asp-for="Input.NewPassword">Password baru</label>
    <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" autofocus/>
    <span asp-validation-for="Input.NewPassword" class="field-error"></span>
    <p class="hint">Butuh @string.Join(", ", Model.PasswordRules).</p>

    <label asp-for="Input.ConfirmPassword">Ulangi password baru</label>
    <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password"/>
    <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>

    <button type="submit">Simpan password</button>
</form>

<p class="links"><a asp-page="Login">Kembali ke halaman masuk</a></p>
