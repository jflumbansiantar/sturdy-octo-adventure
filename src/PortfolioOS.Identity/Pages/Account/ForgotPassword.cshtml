@page
@model PortfolioOS.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Lupa password";
}

<h1>Lupa password</h1>
<p class="sub">Masukkan email akun Anda. Kami kirimkan kode sekali pakai untuk mengatur ulang password.</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert">@Model.ErrorMessage</div>
}

<form method="post">
    <label asp-for="Input.Email">Email</label>
    <input asp-for="Input.Email" type="email" autocomplete="email" autofocus/>
    <span asp-validation-for="Input.Email" class="field-error"></span>

    <button type="submit">Kirim kode</button>
</form>

<p class="links"><a asp-page="Login">Kembali ke halaman masuk</a></p>
